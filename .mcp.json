{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "intellij": {
      "type": "http",
      "url": "http://127.0.0.1:64342/stream"
    },
    "minecraft-dev": {
      "type": "stdio",
      "command": "fnm",
      "args": [
        "exec",
        "--using=20",
        "cmd",
        "/c",
        "npx",
        "-y",
        "@mcdxai/minecraft-dev-mcp@1.3.0"
      ],
      "env": {
        "JAVA_HOME": "C:\\Program Files\\Eclipse Adoptium\\jdk-25.0.5.8-hotspot"
      }
    },
    "blockbench": {
      "type": "stdio",
      "command": "node",
      "args": [
        "tools/blockbench-mcp/node_modules/blockbench-mcp/bin/blockbench-mcp-headless.mjs",
        "--root",
        "./art"
      ]
    }
  }
}
