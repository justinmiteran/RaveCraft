{
	"schemaVersion": 1,
	"id": "ravecraft",
	"version": "${version}",
	"name": "RaveCraft",
	"description": "Functional, realistic sound, DJ and lighting gear: from a portable speaker to a festival soundsystem.",
	"authors": [
		"Justin"
	],
	"contact": {
		"homepage": "https://github.com/justinmiteran/RaveCraft",
		"sources": "https://github.com/justinmiteran/RaveCraft",
		"issues": "https://github.com/justinmiteran/RaveCraft/issues"
	},
	"license": [
		"LGPL-3.0-only",
		"CC-BY-NC-SA-4.0"
	],
	"icon": "assets/ravecraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.ravecraft.mod.RaveCraft"
		],
		"client": [
			"com.ravecraft.mod.client.RaveCraftClient"
		],
		"fabric-datagen": [
			"com.ravecraft.mod.datagen.RaveCraftDataGenerator"
		]
	},
	"accessWidener": "ravecraft.classtweaker",
	"mixins": [
		"ravecraft.mixins.json",
		{
			"config": "ravecraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.166.2"
	},
	"suggests": {
		"jei": "*"
	}
}
